# Admin password for /admin/* routes
ADMIN_PASSWORD=changeme

# Random secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=replace-with-a-32+character-random-string

# Public site URL (used for sitemap, RSS, canonical, hreflang)
NEXT_PUBLIC_SITE_URL=https://daeseon.ai

# --- GitHub-backed authoring (required in production) ---
# Personal Access Token with `repo` scope (fine-grained: Contents read+write on this repo)
GITHUB_TOKEN=
# owner/repo, e.g. daseon/daseon-blog
GITHUB_REPO=
# Default branch for commits
GITHUB_BRANCH=main

# --- Crosspost webhook (optional) ---
# If set, admin "Publish" will POST a JSON payload to this URL after the GitHub commit.
# Leave blank to skip.
CROSSPOST_WEBHOOK_URL=
# Optional HMAC-SHA256 secret; if set, sends header X-Signature-256: sha256=<hex>
CROSSPOST_WEBHOOK_SECRET=

# --- RAG manifest API (optional) ---
# 32+ char random token. GET /api/rag/manifest requires Authorization: Bearer <this>.
# Without this, the endpoint returns 401 for everyone.
RAG_API_TOKEN=
